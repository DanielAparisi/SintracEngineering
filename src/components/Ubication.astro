---
import SectionContainer from "./SectionContainer.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Button from "./ui/Button.astro";
import { company, formattedAddress } from "../data/company";

// El JSON-LD de esta sección se ha eliminado: declaraba una segunda entidad de
// negocio (con otra dirección) que competía con la de `Layout.astro`. Ahora
// existe un único `@graph` en el layout, generado desde `company.ts`.

const mapsQuery = encodeURIComponent(formattedAddress);
---

<SectionContainer id="contacto" class="py-24">
  <div class="mb-16">
    <SectionHeading kicker="Dónde estamos" titulo="Ubicación" />
  </div>

  <div class="flex flex-col md:flex-row gap-10 items-stretch">

    <!-- Información -->
    <div class="flex flex-col gap-8 md:w-72 shrink-0">

      <div class="flex flex-col gap-1.5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Dirección</p>
        <p class="text-base text-ink-secondary leading-relaxed">
          {company.address.street}<br />{company.address.postalCode}
          {company.address.locality}, {company.address.region}
        </p>
      </div>

      <div class="flex flex-col gap-1.5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Horario de oficina</p>
        <p class="text-base text-ink-secondary">
          {company.openingHours.daysLabel}
        </p>
        <p class="text-sm text-ink-muted">
          {company.openingHours.opens} – {company.openingHours.closes}
        </p>
      </div>

      <div class="flex flex-col gap-1.5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Teléfono</p>
        <a
          href={`tel:${company.phone.e164}`}
          class="text-base text-ink-secondary no-underline hover:text-ink transition-colors duration-150"
        >
          {company.phone.display}
        </a>
      </div>

      <div class="flex flex-col gap-1.5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">Email</p>
        <a
          href={`mailto:${company.email}`}
          class="text-base text-ink-secondary no-underline hover:text-ink transition-colors duration-150 break-all"
        >
          {company.email}
        </a>
      </div>

      <Button
        href={`https://maps.google.com/?q=${mapsQuery}`}
        variante="contorno"
        externo
        class="mt-auto w-fit"
      >
        Cómo llegar →
      </Button>

    </div>

    <!-- Mapa -->
    <div class="flex-1 rounded-2xl overflow-hidden border border-border min-h-80">
      <iframe
        title={`Ubicación ${company.name} — ${formattedAddress}`}
        width="100%"
        height="100%"
        style="border:0; min-height: 320px;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        src={`https://maps.google.com/maps?q=${mapsQuery}&output=embed&hl=es`}
      >
      </iframe>
    </div>

  </div>
</SectionContainer>
