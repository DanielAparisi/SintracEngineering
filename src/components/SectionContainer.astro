---
/** Ancho máximo y márgenes laterales comunes a todas las secciones. */
interface Props {
  id?: string;
  /** Espaciado vertical propio de cada sección; el horizontal ya lo pone esto. */
  class?: string;
}

const { class: className, id } = Astro.props;
---

<section
  id={id}
  class:list={[
    "w-full mx-auto px-6 md:px-12 lg:px-20 max-w-[1440px]",
    className,
  ]}
>
  <slot />
</section>
