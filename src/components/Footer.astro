---
import { company } from "../data/company";
---

<footer class="w-full border-t-4 border-(--color-accent) bg-(--color-bg-card)">
  <div class="w-full max-w-360 mx-auto px-6 md:px-12 lg:px-20 py-16">
    <!-- Fila principal -->
    <div class="flex flex-col md:flex-row justify-between gap-12">
      <!-- Marca -->
      <div class="flex flex-col gap-8 max-w-45">
        <img
          src="/logo.png"
          alt={company.name}
          width="143"
          height="48"
          class="h-10 sm:h-12 w-auto"
        />
        <p class="text-sm text-(--color-text-muted) leading-relaxed">
          Constructora inmobiliaria en {company.areaServed.primary}. Más de {
            company.yearsOfExperience
          } años construyendo en el norte de Madrid.
        </p>
      </div>

      <!-- Navegación -->
      <div class="flex flex-col gap-3">
        <p
          class="text-xs font-semibold uppercase tracking-[0.12em] text-(--color-accent)"
        >
          Navegación
        </p>
        <ul class="flex flex-col gap-2 list-none m-0 p-0">
          <li>
            <a
              href="/#proyectos"
              class="text-sm text-(--color-text-secondary) no-underline hover:text-(--color-accent) transition-colors duration-150"
              >Proyectos</a
            >
          </li>
          <li>
            <a
              href="/#nosotros"
              class="text-sm text-(--color-text-secondary) no-underline hover:text-(--color-accent) transition-colors duration-150"
              >Nosotros</a
            >
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div class="flex flex-col gap-3">
        <p
          class="text-xs font-semibold uppercase tracking-[0.12em] text-(--color-accent)"
        >
          Contacto
        </p>
        <ul class="flex flex-col gap-2 list-none m-0 p-0">
          <li class="text-sm text-(--color-text-secondary)">
            {company.address.locality}, {company.address.region}
          </li>
          <li>
            <a
              href={`tel:${company.phone.e164}`}
              class="text-sm text-(--color-text-secondary) no-underline hover:text-(--color-accent) transition-colors duration-150"
              >{company.phone.display}</a
            >
          </li>
          <li>
            <a
              href={`mailto:${company.email}`}
              class="text-sm text-(--color-text-secondary) no-underline hover:text-(--color-accent) transition-colors duration-150"
              >{company.email}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Divisor + Copyright -->
    <div
      class="mt-12 pt-6 border-t border-(--color-border) flex flex-col sm:flex-row justify-between items-center gap-3"
    >
      <p class="text-xs text-(--color-text-muted)">
        © {new Date().getFullYear()} {company.name}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-(--color-text-muted)">
        {company.address.locality} · {company.address.region} · {
          company.address.countryName
        }
      </p>
    </div>

    <!-- Créditos desarrollador -->
    <div class="flex flex-col items-center gap-1 mt-6">
      <p class="text-xs text-(--color-text-muted)">
        Página web desarrollada por <a
          class="text-(--color-accent) font-bold"
          target="_blank"
          rel="noopener noreferrer"
          href="https://github.com/DanielAparisi">Daniel Aparisi</a
        >
      </p>
    </div>
  </div>
</footer>
