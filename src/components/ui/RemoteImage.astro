---
/**
 * Foto alojada en la biblioteca de WordPress.
 *
 * Concentra el contrato de una imagen remota —`srcset` con las variantes,
 * `width`/`height` para reservar el hueco, y qué hacer si el fichero ya no
 * está— que antes estaba copiado en cuatro plantillas y se desincronizaba:
 * una llevaba `loading="lazy"` y otra no, una traía `sizes` y otra tampoco.
 *
 * Va siempre dentro de un contenedor `relative` junto a `<ImagePlaceholder />`:
 * la foto se pinta encima y, si falla, ese componente la desvanece y deja ver
 * el hueco (`data-remote-image` es lo que las enlaza).
 */
import { fotoSrc, fotoSrcset, type Foto } from "../../data/promociones";

interface Props {
  foto: Foto;
  /** Ancho real del hueco por breakpoint, para que el navegador elija variante. */
  sizes: string;
  /**
   * Foto visible sin hacer scroll (la portada de una ficha). Se descarga con
   * prioridad en vez de en diferido; para el resto, `lazy` es lo correcto.
   */
  priority?: boolean;
  class?: string;
}

const { foto, sizes, priority = false, class: className } = Astro.props;
---

<img
  src={fotoSrc(foto)}
  srcset={fotoSrcset(foto)}
  sizes={sizes}
  width={foto.width}
  height={foto.height}
  alt={foto.alt}
  decoding="async"
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  data-remote-image
  class:list={["relative w-full h-full object-cover", className]}
/>
