---
/**
 * Hueco de reserva de una foto: se ve mientras la imagen carga y se queda si
 * falla. Va detrás de la `<img>`, así que el contenedor debe ser `relative`.
 *
 * Existe como componente porque el mismo SVG estaba pegado en cuatro sitios y
 * ya divergía en el tamaño.
 */
interface Props {
  /** Lado del icono en píxeles. 36 en el collage, 48 en las fotos grandes. */
  size?: number;
}

const { size = 48 } = Astro.props;
---

<div
  class="absolute inset-0 flex items-center justify-center text-ink-muted opacity-20 select-none"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <path d="m21 15-5-5L5 21"></path>
    <circle cx="9" cy="9" r="2"></circle>
  </svg>
</div>

<script>
  /**
   * Desvanece las fotos que no cargan para que se vea el hueco de reserva.
   *
   * Sustituye al `onerror="this.style.display='none'"` que llevaba cada `<img>`
   * en línea: un handler inline rompe cualquier CSP que se añada más adelante.
   * Vive aquí, y no en `RemoteImage`, porque el placeholder es lo que acompaña
   * a toda imagen remota del sitio, tenga o no variantes de WordPress. Astro
   * agrupa el script una sola vez por página, no uno por imagen.
   */
  const ocultar = (img: HTMLImageElement) => {
    img.style.opacity = "0";
  };

  document
    .querySelectorAll<HTMLImageElement>("img[data-remote-image]")
    .forEach((img) => {
      // `complete` con ancho 0 significa que la carga ya falló antes de que
      // este script llegara a registrarse; el evento `error` ya no se emitirá.
      if (img.complete && img.naturalWidth === 0) ocultar(img);
      img.addEventListener("error", () => ocultar(img));
    });
</script>
