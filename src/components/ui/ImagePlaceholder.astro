---
/**
 * Hueco de reserva de una foto: se ve mientras la imagen carga. Va detrás de
 * la `<picture>`, así que el contenedor debe ser `relative`.
 *
 * Existe como componente porque el mismo SVG estaba pegado en cuatro sitios y
 * ya divergía en el tamaño.
 *
 * Antes traía además un script que desvanecía las fotos que no cargaban: las
 * imágenes venían de la biblioteca de WordPress y podían haberse borrado allí.
 * Ahora se importan de `src/assets/` y las resuelve el build, así que una foto
 * que falte es un error de compilación, no un hueco roto en producción; el
 * script sobraba y solo añadía JavaScript a todas las páginas.
 */
interface Props {
  /** Lado del icono en píxeles. 36 en el collage, 48 en las fotos grandes. */
  size?: number;
}

const { size = 48 } = Astro.props;
---

<div
  class="absolute inset-0 flex items-center justify-center text-ink-muted opacity-20 select-none"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <path d="m21 15-5-5L5 21"></path>
    <circle cx="9" cy="9" r="2"></circle>
  </svg>
</div>
