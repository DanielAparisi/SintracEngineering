---
/**
 * Listado de promociones de la home, agrupado por estado.
 *
 * Los grupos se declaran como datos: añadir un estado nuevo a `promociones.ts`
 * es añadir una entrada aquí, no duplicar el bloque de renderizado.
 */
import SectionContainer from "./SectionContainer.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import PromocionCard from "./PromocionCard.astro";
import { finalizados, enMarcha } from "../data/promociones";

const grupos = [
  { kicker: "Trayectoria", titulo: "Promociones Terminadas", items: finalizados },
  { kicker: "Actualidad", titulo: "Promociones en Marcha", items: enMarcha },
];
---

<div class="w-full bg-surface-card">
  <SectionContainer id="proyectos" class="py-32">
    {
      grupos.map((grupo, i) => (
        <div class:list={["flex flex-col gap-20", i < grupos.length - 1 && "mb-36"]}>
          <SectionHeading kicker={grupo.kicker} titulo={grupo.titulo} />

          <div class="flex flex-col">
            {grupo.items.map((promocion, j) => (
              <PromocionCard
                promocion={promocion}
                ultima={j === grupo.items.length - 1}
              />
            ))}
          </div>
        </div>
      ))
    }
  </SectionContainer>
</div>
