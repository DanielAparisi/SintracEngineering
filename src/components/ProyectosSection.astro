---
import SectionContainer from "./SectionContainer.astro";
import {
  finalizados,
  enMarcha,
  promocionPath,
  portada,
  fotoSrc,
  fotoSrcset,
} from "../data/promociones";
---

<div class="w-full bg-(--color-bg-card)">
<SectionContainer id="proyectos" class="py-32">

  <!-- PROMOCIONES TERMINADAS -->
  <div class="flex flex-col gap-20 mb-36">

    <!-- Título centrado -->
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="text-xs font-semibold tracking-[0.15em] uppercase text-(--color-text-muted)">Trayectoria</span>
      <h2 class="text-[clamp(2.5rem,6vw,5rem)] font-bold leading-none tracking-[-0.03em] text-(--color-text)">Promociones Terminadas</h2>
    </div>

    <!-- Lista de promociones finalizadas -->
    <div class="flex flex-col">
      {finalizados.map((p, i) => (
        <div class={`flex flex-col md:flex-row items-stretch gap-0 border-t border-(--color-border) py-10 md:py-16 ${i === finalizados.length - 1 ? 'border-b' : ''}`}>

          <!-- Texto izquierda -->
          <div class="flex flex-col justify-between gap-8 flex-1 pr-0 md:pr-16">
            <div class="flex flex-col gap-5">
              <div class="flex items-center gap-3">
                <span class="text-xs font-semibold tracking-[0.12em] uppercase text-(--color-accent-dark)">Entregado</span>
                <span class="text-xs font-bold text-white bg-(--color-accent) px-2.5 py-1 rounded-full">{p.year}</span>
              </div>
              <h3 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold leading-tight tracking-[-0.02em]">
                <a
                  href={promocionPath(p)}
                  class="text-(--color-text) no-underline transition-colors duration-150 hover:text-(--color-accent) focus-visible:text-(--color-accent)"
                >
                  {p.nombre}
                </a>
              </h3>
              <p class="text-sm text-(--color-text-muted)">{p.ubicacion}</p>
              <p class="text-base text-(--color-text-secondary) leading-relaxed max-w-md">{p.descripcion}</p>
            </div>
            <div class="flex gap-8">
              {p.viviendas && (
                <div>
                  <p class="text-2xl font-bold text-(--color-accent)">{p.viviendas}</p>
                  <p class="text-xs text-(--color-text-muted) uppercase tracking-wide mt-0.5">Viviendas</p>
                </div>
              )}
              {p.periodo && (
                <div>
                  <p class="text-2xl font-bold text-(--color-accent)">{p.periodo}</p>
                  <p class="text-xs text-(--color-text-muted) uppercase tracking-wide mt-0.5">Obra</p>
                </div>
              )}
              <div>
                <p class="text-2xl font-bold text-(--color-accent)">100%</p>
                <p class="text-xs text-(--color-text-muted) uppercase tracking-wide mt-0.5">Vendidas</p>
              </div>
            </div>
          </div>

          <!-- Imagen derecha -->
          <div class="relative w-full md:w-[52%] shrink-0 aspect-4/3 sm:aspect-16/10 md:aspect-auto md:min-h-72 rounded-2xl overflow-hidden bg-(--color-bg-secondary) mt-8 md:mt-0">
            {/* Placeholder detrás de la foto: solo se ve si la imagen falla. */}
            <div class="absolute inset-0 flex items-center justify-center text-(--color-text-muted) opacity-20 select-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="m21 15-5-5L5 21"></path><circle cx="9" cy="9" r="2"></circle></svg>
            </div>
            <img
              src={fotoSrc(portada(p))}
              srcset={fotoSrcset(portada(p))}
              sizes="(min-width: 768px) 52vw, 92vw"
              width={portada(p).width}
              height={portada(p).height}
              alt={portada(p).alt}
              class="relative w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          </div>

        </div>
      ))}
    </div>
  </div>

  <!-- PROMOCIONES EN MARCHA -->
  <div class="flex flex-col gap-20">

    <!-- Título centrado -->
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="text-xs font-semibold tracking-[0.15em] uppercase text-(--color-text-muted)">Actualidad</span>
      <h2 class="text-[clamp(2.5rem,6vw,5rem)] font-bold leading-none tracking-[-0.03em] text-(--color-text)">Promociones en Marcha</h2>
    </div>

    <!-- Lista de promociones en marcha -->
    <div class="flex flex-col">
      {enMarcha.map((p, i) => (
        <div class={`flex flex-col md:flex-row items-stretch gap-0 border-t border-(--color-border) py-10 md:py-16 ${i === enMarcha.length - 1 ? 'border-b' : ''}`}>

          <!-- Texto izquierda -->
          <div class="flex flex-col justify-between gap-8 flex-1 pr-0 md:pr-16">
            <div class="flex flex-col gap-5">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                <span class="text-xs font-semibold tracking-[0.12em] uppercase text-green-600">En obras</span>
              </div>
              <h3 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold leading-tight tracking-[-0.02em]">
                <a
                  href={promocionPath(p)}
                  class="text-(--color-text) no-underline transition-colors duration-150 hover:text-(--color-accent) focus-visible:text-(--color-accent)"
                >
                  {p.nombre}
                </a>
              </h3>
              <p class="text-sm text-(--color-text-muted)">{p.ubicacion}</p>
              <p class="text-base text-(--color-text-secondary) leading-relaxed max-w-md">{p.descripcion}</p>
            </div>
            <div class="flex gap-8">
              <div>
                <p class="text-2xl font-bold text-(--color-accent)">{p.viviendas}</p>
                <p class="text-xs text-(--color-text-muted) uppercase tracking-wide mt-0.5">Viviendas</p>
              </div>
              <div>
                <p class="text-2xl font-bold text-(--color-accent)">{p.year}</p>
                <p class="text-xs text-(--color-text-muted) uppercase tracking-wide mt-0.5">Entrega prevista</p>
              </div>
            </div>
          </div>

          <!-- Imagen derecha -->
          <div class="relative w-full md:w-[52%] shrink-0 aspect-4/3 sm:aspect-16/10 md:aspect-auto md:min-h-72 rounded-2xl overflow-hidden bg-(--color-bg-secondary) mt-8 md:mt-0">
            {/* Placeholder detrás de la foto: solo se ve si la imagen falla. */}
            <div class="absolute inset-0 flex items-center justify-center text-(--color-text-muted) opacity-20 select-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="m21 15-5-5L5 21"></path><circle cx="9" cy="9" r="2"></circle></svg>
            </div>
            <img
              src={fotoSrc(portada(p))}
              srcset={fotoSrcset(portada(p))}
              sizes="(min-width: 768px) 52vw, 92vw"
              width={portada(p).width}
              height={portada(p).height}
              alt={portada(p).alt}
              class="relative w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          </div>

        </div>
      ))}
    </div>
  </div>

</SectionContainer>
</div>
