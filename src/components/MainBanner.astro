---
/**
 * Collage de fotos.
 *
 * La colocación es explícita (`col-start` / `row-start`) en lugar de automática
 * porque los spans no encajan igual en 2 columnas que en 4: con auto-placement,
 * la foto ancha no cabe junto a la vertical en móvil y acaba en una fila
 * implícita de altura `auto`, donde las imágenes `h-full` colapsan a 0.
 *
 * Móvil (2 col): vertical ocupa la columna izquierda entera, dos fotos apiladas
 * a la derecha, y las dos anchas a todo el ancho debajo.
 * Desktop (4 col x 2 filas): el collage original.
 */
import ImagePlaceholder from "./ui/ImagePlaceholder.astro";
import Photo from "./ui/Photo.astro";
import { company } from "../data/company";
import { portada, finalizados } from "../data/promociones";

import obra1 from "../assets/nosotros/obra-1.jpg";
import obra2 from "../assets/nosotros/obra-2.jpg";
import obra3 from "../assets/nosotros/obra-3.jpg";
import obra4 from "../assets/nosotros/obra-4.jpg";

/**
 * Cada hueco declara su propio `sizes` porque el collage no es uniforme: las
 * celdas anchas ocupan el doble que las normales, y darles a todas el mismo
 * valor haría que unas se bajaran una variante corta y otras una de sobra.
 */
const CELDA = "(min-width: 768px) 25vw, 46vw";
const CELDA_ANCHA = "(min-width: 768px) 50vw, 92vw";

const fotos = [
  {
    foto: {
      src: obra1,
      alt: "Edificio de viviendas entregado, visto desde la calle peatonal",
    },
    sizes: CELDA,
    // Vertical: ocupa las dos filas de la izquierda en ambos breakpoints.
    position:
      "col-start-1 row-start-1 row-span-2 md:col-start-1 md:row-start-1 md:row-span-2",
  },
  {
    foto: {
      src: obra2,
      alt: "Fachada ventilada y acceso al garaje de un edificio de viviendas",
    },
    sizes: CELDA_ANCHA,
    // Ancha: a todo el ancho en móvil, centro-arriba en desktop.
    position:
      "col-start-1 col-span-2 row-start-3 md:col-start-2 md:col-span-2 md:row-start-1 md:row-span-1",
  },
  {
    foto: {
      src: obra3,
      alt: "Detalle de la fachada con el rótulo de Sintrac Engineering junto al portal",
    },
    sizes: CELDA,
    position: "col-start-2 row-start-1 md:col-start-4 md:row-start-1",
  },
  {
    foto: {
      src: obra4,
      alt: "Esquina del edificio con la caja de escalera acristalada",
    },
    sizes: CELDA,
    position: "col-start-2 row-start-2 md:col-start-2 md:row-start-2",
  },
  {
    // La portada de la última promoción entregada, en vez de una copia suya:
    // así el collage se actualiza solo cuando cambie la primera foto de la ficha.
    foto: portada(finalizados[0]),
    sizes: CELDA_ANCHA,
    // Ancha con las cifras encima: dos filas en móvil para que el overlay respire.
    position:
      "col-start-1 col-span-2 row-start-4 row-span-2 md:col-start-3 md:col-span-2 md:row-start-2 md:row-span-1",
    overlay: true,
  },
];

/**
 * Cifras superpuestas a la última foto. En móvil no caben las tres en una línea,
 * así que el overlay usa una rejilla de 3 columnas (etiqueta partida en dos
 * líneas) en lugar de un `flex-wrap` que rompía de forma irregular.
 */
const cifras = [
  { valor: `+${company.yearsOfExperience}`, etiqueta: "Años de trayectoria" },
  { valor: company.deliveredProjects, etiqueta: "Proyectos entregados" },
  { valor: "SANSE", etiqueta: company.areaServed.region },
];
---

<section id="nosotros" class="w-full bg-surface-muted">
  <!-- Cabecera -->
  <div
    class="w-full px-6 md:px-12 lg:px-20 max-w-360 mx-auto pt-24 pb-12 flex flex-col md:flex-row md:items-end justify-between gap-8"
  >
    <div class="flex flex-col gap-4">
      <span
        class="text-xs font-semibold tracking-[0.15em] uppercase text-accent border border-accent rounded-full px-3 py-1 w-fit bg-accent-light"
      >
        Quiénes somos
      </span>
      <h2
        class="text-[clamp(3rem,7vw,8rem)] font-bold leading-[0.95] tracking-[-0.04em] text-black uppercase"
      >
        Sintrac<br /><span class="text-accent">Engineering</span>
      </h2>
    </div>
    <p class="text-base text-black/70 leading-relaxed max-w-sm">
      Construimos viviendas en las que las familias confían desde 2003. Calidad,
      compromiso y rigor en cada proyecto del norte de Madrid.
    </p>
  </div>

  <!-- Collage de imágenes -->
  <div class="w-full px-6 md:px-12 lg:px-20 max-w-360 mx-auto pb-16">
    <div
      class="grid grid-cols-2 gap-2.5 sm:gap-3 auto-rows-[7.5rem] sm:auto-rows-[10rem] md:grid-cols-4 md:grid-rows-2 md:auto-rows-auto md:h-150"
    >
      {
        fotos.map((celda) => (
          <div
            class={`${celda.position} rounded-2xl overflow-hidden bg-surface-muted relative`}
          >
            <ImagePlaceholder size={36} />
            <Photo foto={celda.foto} sizes={celda.sizes} />
            {celda.overlay && (
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent grid grid-cols-3 items-end gap-x-3 p-4 sm:flex sm:gap-x-8 sm:p-6">
                {cifras.map((cifra) => (
                  <div>
                    <p class="text-2xl sm:text-3xl font-bold text-white">
                      {cifra.valor}
                    </p>
                    <p class="text-[0.65rem] sm:text-xs text-white/60 mt-0.5 uppercase tracking-wide">
                      {cifra.etiqueta}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
