---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { company, faq, shortDescription } from "../data/company";

interface Props {
  title: string;
  description: string;
  keywords?: string;
  /** Imagen de las previsualizaciones (WhatsApp, LinkedIn). URL absoluta. */
  image?: string;
}

/**
 * URL canónica de la página. Se construye contra `site` (astro.config.mjs) en
 * vez de usar `Astro.url.href`, que en dev apunta a localhost y en build al
 * host desde el que se compile.
 */
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const {
  title,
  description,
  keywords = "constructora inmobiliaria Madrid, obra nueva Madrid, constructora San Sebastián de los Reyes, promociones inmobiliarias Madrid norte, empresa constructora SANSE, Sintrac Engineering",
  image = new URL("/og-image.jpg", Astro.site).href,
} = Astro.props;

/**
 * Un único bloque JSON-LD para todo el sitio, generado desde `company.ts`.
 * Antes había dos entidades de negocio distintas (aquí y en `Ubication.astro`)
 * con `@type` y dirección diferentes, lo que Google puede leer como dos
 * negocios y repartir la autoridad local entre ambos.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "GeneralContractor",
      "@id": `${company.url}/#business`,
      name: company.name,
      url: company.url,
      description: shortDescription,
      foundingDate: String(company.foundingYear),
      address: {
        "@type": "PostalAddress",
        streetAddress: company.address.street,
        postalCode: company.address.postalCode,
        addressLocality: company.address.locality,
        addressRegion: company.address.region,
        addressCountry: company.address.country,
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: company.geo.latitude,
        longitude: company.geo.longitude,
      },
      telephone: company.phone.e164,
      email: company.email,
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [...company.openingHours.days],
          opens: company.openingHours.opens,
          closes: company.openingHours.closes,
        },
      ],
      areaServed: company.areaServed.municipalities.map((name) => ({
        "@type": "City",
        name,
      })),
      priceRange: "€€€",
    },
    {
      "@type": "WebSite",
      "@id": `${company.url}/#website`,
      url: company.url,
      name: company.name,
      inLanguage: "es-ES",
      publisher: { "@id": `${company.url}/#business` },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["h1", "h2", ".speakable"],
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${company.url}/#faq`,
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1E3A5F" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={company.name} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sintrac Engineering" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Schema JSON-LD (generado desde src/data/company.ts) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>

</html>
