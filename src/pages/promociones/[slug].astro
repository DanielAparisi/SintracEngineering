---
/**
 * Ficha de una promoción — ruta dinámica.
 *
 * `[slug]` se resuelve en tiempo de build con `getStaticPaths()`: Astro genera
 * un HTML estático por cada promoción de `src/data/promociones.ts`, así que
 * añadir una promoción al array crea su página sola, sin tocar este fichero.
 *
 * La promoción se pasa entera por `props` en lugar de buscarla aquí por el
 * `slug` de `Astro.params`: así no hay que contemplar el caso "no existe".
 */
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import Gallery from "../../components/Gallery.astro";
import Button from "../../components/ui/Button.astro";
import EstadoBadge from "../../components/ui/EstadoBadge.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";
import Photo from "../../components/ui/Photo.astro";
import { getImage } from "astro:assets";
import { promociones, portada, type Promocion } from "../../data/promociones";
import { company } from "../../data/company";

export function getStaticPaths() {
  return promociones.map((promocion) => ({
    params: { slug: promocion.slug },
    props: { promocion },
  }));
}

interface Props {
  promocion: Promocion;
}

const { promocion } = Astro.props;
const entregada = promocion.estado === "entregado";

/** La portada abre la ficha; el resto de fotos van a la galería de abajo. */
const cubierta = portada(promocion);
const resto = promocion.galeria.slice(1);

/** Los datos que no constan (p. ej. viviendas de las obras antiguas) se omiten. */
const ficha = [
  { etiqueta: "Viviendas", valor: promocion.viviendas },
  {
    etiqueta: entregada ? "Año de entrega" : "Entrega prevista",
    valor: promocion.year,
  },
  { etiqueta: "Periodo de obra", valor: promocion.periodo },
  { etiqueta: "Estado", valor: entregada ? "Entregada" : "En obras" },
  {
    etiqueta: "Disponibilidad",
    valor: entregada ? "100% vendida" : "Consultar",
  },
].filter((d): d is { etiqueta: string; valor: string } => Boolean(d.valor));

const mapsQuery = encodeURIComponent(promocion.ubicacion);

/**
 * Previsualización al compartir la ficha. Se recorta a 1200×630 —la proporción
 * que esperan Open Graph y Twitter— y se fuerza JPEG porque varios lectores de
 * enlaces (WhatsApp entre ellos) no interpretan AVIF y se quedarían sin imagen.
 * La URL ha de ser absoluta: quien la lee no es el navegador, sino un bot.
 */
const ogImage = await getImage({
  src: cubierta.src,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
});
---

<Layout
  title={`${promocion.nombre} | ${company.name}`}
  description={promocion.descripcion.slice(0, 155)}
  keywords={`${promocion.nombre}, obra nueva ${promocion.ubicacion}, promoción inmobiliaria, ${company.name}`}
  image={new URL(ogImage.src, Astro.site).href}
>
  <SectionContainer class="pt-12 pb-24 md:pt-16">
    <!-- Migas -->
    <nav aria-label="Migas de pan" class="mb-10">
      <a
        href="/#proyectos"
        class="text-sm text-ink-muted no-underline hover:text-accent transition-colors duration-150"
      >
        ← Volver a promociones
      </a>
    </nav>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">
      <!-- Contenido -->
      <div class="flex flex-col gap-8 flex-1 order-2 lg:order-1">
        <div class="flex flex-col gap-5">
          <EstadoBadge estado={promocion.estado} year={promocion.year} />

          <h1
            class="text-[clamp(2rem,5vw,3.5rem)] font-bold leading-tight tracking-[-0.03em] text-ink"
          >
            {promocion.nombre}
          </h1>

          <p class="text-sm text-ink-muted">{promocion.ubicacion}</p>
        </div>

        <p
          class="text-base md:text-lg text-ink-secondary leading-relaxed max-w-2xl"
        >
          {promocion.descripcion}
        </p>

        <!-- Ficha técnica -->
        <dl
          class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-8 py-8 border-y border-border"
        >
          {
            ficha.map((dato) => (
              <div>
                <dt class="text-xs text-ink-muted uppercase tracking-wide">
                  {dato.etiqueta}
                </dt>
                <dd class="text-2xl font-bold text-accent mt-1">
                  {dato.valor}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="flex flex-wrap gap-3">
          <Button href="/#contacto">Solicitar información</Button>
          <Button
            href={`https://maps.google.com/?q=${mapsQuery}`}
            variante="contorno"
            externo
          >
            Ver ubicación →
          </Button>
        </div>
      </div>

      <!-- Imagen: primero en móvil, columna derecha en escritorio -->
      <div
        class="relative w-full lg:w-[46%] shrink-0 aspect-4/3 sm:aspect-16/10 rounded-2xl overflow-hidden bg-surface-muted order-1 lg:order-2 lg:sticky lg:top-20"
      >
        <ImagePlaceholder />
        <Photo
          foto={cubierta}
          sizes="(min-width: 1024px) 46vw, 92vw"
          priority
        />
      </div>
    </div>

    <div class="mt-20 md:mt-28">
      <Gallery fotos={resto} titulo="Cómo es la promoción" />
    </div>
  </SectionContainer>
</Layout>
